algoritmo "script_repita"

var
  senha: caractere
inicio
  repita
    escreva("Digite a senha de acesso: ")
    leia(senha)
    se (senha <> "1234") entao
      escreval("Senha incorreta! Tente novamente.")
    fimse
   ate (senha = "1234")
   
   escreval("Acesso liberado com sucesso!")
fimalgoritmo