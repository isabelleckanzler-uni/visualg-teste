algoritmo "Decisão2-10"

var
  opcao: inteiro
   n1, n2, resultado: real

inicio


  escreval("Escolher qual função vai fazer:")
  escreval("1- Multiplicar | 2-  Subtrair | 3 - Somar ")
  leia(opcao)
  escolha opcao
   caso 1
    escreval("Digite o primeiro número:")
    leia(n1)
    escreval("Digite o segundo número:")
    leia(n2)
    resultado <- n1 * n2
    escreval("Resultado da multiplicação: ", resultado)

   caso 2
    escreval("Digite o primeiro número:")
    leia(n1)
    escreval("Digite o segundo número:")
    leia(n2)
    resultado <- n1 - n2
    escreval("Resultado da subtração: ", resultado)

  caso 3
    escreval("Digite o primeiro número:")
    leia(n1)
    escreval("Digite o segundo número:")
    leia(n2)
    resultado <- n1 + n2
    escreval("Resultado da soma: ", resultado)

  outrocaso
  escreval("Opção inválida!")
   fimescolha

  fimalgoritmo 